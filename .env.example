# Chronicle AI - Environment Configuration Example

# Server Network
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chronicle?retryWrites=true&w=majority

# Security (JWT Secrets)
JWT_SECRET=super_secret_jwt_sign_key_for_chronicle_security
JWT_ACCESS_SECRET=access_token_secret_key_sign_hash_value_123
JWT_REFRESH_SECRET=refresh_token_secret_key_sign_hash_value_456

# Cache Store (Redis URL)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Machine Learning Service URL
FASTAPI_URL=http://localhost:8000

# E-Mail Notifications (Nodemailer credentials)
EMAIL_USER=notifications@chronicle.ai
EMAIL_PASS=smtp_secure_password_credentials

# External Content feeds (Optional)
NEWS_API_KEY=
GEMINI_API_KEY=
